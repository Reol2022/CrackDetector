# 模型文件
checkpoints/*.pth

# 数据集文件 - 保留目录但忽略内容
data/SDNET2018_extracted/*
data/train/*
data/val/*

# 但保留空目录的标记文件（可选）
!data/SDNET2018_extracted/.gitkeep
!data/train/.gitkeep
!data/val/.gitkeep
!checkpoints/.gitkeep

